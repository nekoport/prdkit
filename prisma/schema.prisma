generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String?
  image         String?
  provider      String       @default("credentials")
  role          String       @default("user")
  emailVerified DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  prdDocuments  PrdDocument[]
  chatThreads   ChatThread[]

  @@index([email])
}

model PrdDocument {
  id          String       @id @default(cuid())
  title       String
  idea        String
  markdown    String
  summary     String?
  isPublic    Boolean      @default(false)
  tags        String?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatThreads ChatThread[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model ChatThread {
  id         String       @id @default(cuid())
  prdId      String
  prd        PrdDocument  @relation(fields: [prdId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([prdId])
}
